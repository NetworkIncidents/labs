#!/usr/bin/env python3
"""dbq REPLICA SQL: run a query on a lab database replica and print the rows."""
import sqlite3, sys

db = sqlite3.connect(f"/data/{sys.argv[1]}.db")
cur = db.execute(sys.argv[2])
rows = cur.fetchall()
cols = [d[0] for d in cur.description]
widths = [max(len(str(x)) for x in [c] + [r[i] for r in rows]) for i, c in enumerate(cols)]
print("  ".join(c.ljust(w) for c, w in zip(cols, widths)).rstrip())
for r in rows:
    print("  ".join(str(x).ljust(w) for x, w in zip(r, widths)).rstrip())
